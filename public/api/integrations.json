{
  "_meta": {
    "resource": "integrations",
    "version": "1.0",
    "description": "Atividades importadas de plataformas de fitness externas. Na Sprint 1/2 estes dados sao um mock servido localmente pelo Vite, no formato que cada API oficial retornaria. Na Sprint 3 (RF-18), services/api.js troca a URL local pelo endpoint OAuth real de cada provedor sem alterar a UI.",
    "providers": {
      "strava": {
        "label": "Strava",
        "api": "Strava API v3 — GET /api/v3/athlete/activities",
        "auth": "OAuth 2.0 (scope: activity:read)",
        "docs": "https://developers.strava.com/docs/reference/"
      },
      "googlefit": {
        "label": "Google Fit / Health Connect",
        "api": "Health Connect (on-device) — substitui a Fitness REST API descontinuada",
        "auth": "OAuth 2.0 (scope: fitness.activity.read)",
        "docs": "https://developer.android.com/health-and-fitness/guides/health-connect"
      },
      "applehealth": {
        "label": "Apple Health",
        "api": "HealthKit — sem API web; export simulado no formato HKWorkout",
        "auth": "Autorizacao on-device (somente leitura)",
        "docs": "https://developer.apple.com/documentation/healthkit"
      },
      "fitbit": {
        "label": "Fitbit",
        "api": "Fitbit Web API — GET /1/user/-/activities",
        "auth": "OAuth 2.0 (scope: activity)",
        "docs": "https://dev.fitbit.com/build/reference/web-api/"
      },
      "garmin": {
        "label": "Garmin Connect",
        "api": "Garmin Health API — Activity Summaries",
        "auth": "OAuth 1.0a",
        "docs": "https://developer.garmin.com/"
      },
      "samsung": {
        "label": "Samsung Health",
        "api": "Samsung Health Data SDK",
        "auth": "Autorizacao on-device (somente leitura)",
        "docs": "https://developer.samsung.com/health"
      }
    }
  },
